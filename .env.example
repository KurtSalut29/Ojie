# Copy this file to .env and fill in the real values.
# Never commit .env. Only this example file goes into Git.
#
# WARNING: every value in this file is compiled INTO the mobile app
# (flutter run --dart-define-from-file=../.env). Only public values go here.
# Server secrets (Anthropic, Semaphore, RevenueCat...) go in
# supabase/functions/.env instead, which the app never reads.

SUPABASE_URL=
SUPABASE_ANON_KEY=
POWERSYNC_URL=
GOOGLE_WEB_CLIENT_ID=
