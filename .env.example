# Copy this file to .env and fill in the real values.
# Never commit .env. Only this example file goes into Git.

# --- Mobile app (passed to Flutter with --dart-define-from-file) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
POWERSYNC_URL=

# --- Server only (Supabase Edge Function secrets, never in the app) ---
